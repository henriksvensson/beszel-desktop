# Maintainer: Henrik Svensson <1612710+henriksvensson@users.noreply.github.com>
pkgname=beszel-desktop-bin
pkgver=0.4.0
pkgrel=1
pkgdesc="Live Beszel metrics daemon (beszel-relay), CLI (beszel-ctl), and Wayland shell widgets (prebuilt binaries)"
arch=('x86_64' 'aarch64')
url="https://github.com/henriksvensson/beszel-desktop"
license=('MIT')
depends=('glibc' 'gcc-libs')
provides=('beszel-desktop')
conflicts=('beszel-desktop')
source_x86_64=("${url}/releases/download/v${pkgver}/beszel-desktop-v${pkgver}-x86_64-unknown-linux-gnu.tar.gz")
source_aarch64=("${url}/releases/download/v${pkgver}/beszel-desktop-v${pkgver}-aarch64-unknown-linux-gnu.tar.gz")
sha256sums_x86_64=('15ee01b25fc456b9f69eead19826e79c1e537671503eadf80d3687d19ce1b332')
sha256sums_aarch64=('5fd5439a1b6b93a71ef0a9ef503fbdb12ef5d87010561023a1d431a5f3aba5d6')

package() {
    local target
    case "${CARCH}" in
        x86_64)  target="x86_64-unknown-linux-gnu" ;;
        aarch64) target="aarch64-unknown-linux-gnu" ;;
    esac

    cd "beszel-desktop-v${pkgver}-${target}"
    install -Dm755 beszel-relay "${pkgdir}/usr/bin/beszel-relay"
    install -Dm755 beszel-ctl "${pkgdir}/usr/bin/beszel-ctl"

    install -dm755 "${pkgdir}/usr/lib/systemd/user"
    sed 's|%h/.local/bin/beszel-relay|/usr/bin/beszel-relay|g' \
        beszel-relay.service \
        > "${pkgdir}/usr/lib/systemd/user/beszel-relay.service"

    install -Dm644 config.example.toml "${pkgdir}/usr/share/doc/${pkgname}/config.example.toml"
    install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
